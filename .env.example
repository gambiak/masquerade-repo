# Public URL of the deployed App Service. Example:
# https://your-app.azurewebsites.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Azure Database for PostgreSQL Flexible Server
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DATABASE=postgres
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_PORT=5432

# Optional metadata. App Service Authentication (Easy Auth) performs token validation.
# Keep these aligned with the Microsoft Entra app registration used by App Service Authentication.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# Exact signed-in email allowed to open /admin
ADMIN_EMAIL=

# Local development only. NEVER enable this in Azure production.
DEV_AUTH_BYPASS=false
DEV_USER_EMAIL=developer@example.com
DEV_USER_EXTERNAL_ID=local-developer

# Automatic daily puzzle generation

OPENAI_API_KEY=

PUZZLE_CRON_SECRET=

PUZZLE_GENERATOR_MODEL=gpt-5.6-terra

PUZZLE_REVIEWER_MODEL=gpt-5.6-sol
